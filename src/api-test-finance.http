### ==================== 9. 部分更新（PATCH）测试 ====================

### 9.1 ✅ PATCH 只改信用门槛（40→35）
PATCH http://localhost:8080/api/v1/finance/loan-products/{{loan_product_1}}
Content-Type: application/json
Authorization: Bearer {{bank_token}}

{
  "minCreditScore": 35
}

> {%
    client.test("只改信用门槛成功", function() {
        client.assert(response.body.code === 200);
        client.assert(response.body.data.minCreditScore === 35, "门槛降到35");
        client.assert(response.body.data.name === "春耕贷", "名字没变");
        client.assert(response.body.data.annualRate == 4.35, "利率没变");
    });
%}

###

### 9.2 ✅ PATCH 只改利率
PATCH http://localhost:8080/api/v1/finance/loan-products/{{loan_product_1}}
Content-Type: application/json
Authorization: Bearer {{bank_token}}

{
  "annualRate": 3.85
}

> {%
    client.test("只改利率成功", function() {
        client.assert(response.body.data.annualRate == 3.85, "利率更新");
        client.assert(response.body.data.minCreditScore === 35, "门槛保持35");
    });
%}

###

### 9.3 ✅ PATCH 同时改多个字段
PATCH http://localhost:8080/api/v1/finance/loan-products/{{loan_product_1}}
Content-Type: application/json
Authorization: Bearer {{bank_token}}

{
  "minAmount": 5000,
  "maxAmount": 300000,
  "requirements": "种植面积5亩以上即可申请（门槛已降低）"
}

> {%
    client.test("多字段同时更新", function() {
        client.assert(response.body.data.minAmount === 5000);
        client.assert(response.body.data.maxAmount === 300000);
        client.assert(response.body.data.annualRate == 3.85, "利率仍然是上次改的");
    });
%}

###

### 9.4 ✅ PUT 全量更新也不强制所有字段了
PUT http://localhost:8080/api/v1/finance/loan-products/{{loan_product_1}}
Content-Type: application/json
Authorization: Bearer {{bank_token}}

{
  "minCreditScore": 30
}

> {%
    client.test("PUT也支持部分更新", function() {
        client.assert(response.body.data.minCreditScore === 30);
        client.assert(response.body.data.name === "春耕贷", "名字保持");
    });
%}

###

### 9.5 ✅ PATCH 保险产品 — 只改保费
PATCH http://localhost:8080/api/v1/finance/insurance-products/{{ins_product_1}}
Content-Type: application/json
Authorization: Bearer {{insure_token}}

{
  "premium": 15.00
}

> {%
    client.test("保险产品部分更新成功", function() {
        client.assert(response.body.data.premium == 15.00, "保费降为15");
        client.assert(response.body.data.name === "水稻种植险", "名字没变");
        client.assert(response.body.data.coverageAmount == 800, "保额没变");
    });
%}

###

### 9.6 ✅ PATCH 保险产品 — 改保障范围
PATCH http://localhost:8080/api/v1/finance/insurance-products/{{ins_product_1}}
Content-Type: application/json
Authorization: Bearer {{insure_token}}

{
  "coverageScope": "洪涝、干旱、台风、冰雹、病虫害、霜冻导致的减产（新增霜冻保障）"
}

> {%
    client.test("保障范围更新成功", function() {
        client.assert(response.body.data.coverageScope.indexOf("霜冻") >= 0);
        client.assert(response.body.data.premium == 15.00, "保费保持上次修改的值");
    });
%}

###

### 9.7 ❌ PATCH 改名冲突（改成已有的名字）
PATCH http://localhost:8080/api/v1/finance/insurance-products/{{ins_product_2}}
Content-Type: application/json
Authorization: Bearer {{insure_token}}

{
  "name": "水稻种植险"
}

> {%
    client.test("重名被拦截", function() {
        client.assert(response.body.code === 400);
        client.assert(response.body.message.indexOf("同名") >= 0);
    });
%}

###

### 9.8 ✅ PATCH 改成自己原来的名字（不算冲突）
PATCH http://localhost:8080/api/v1/finance/insurance-products/{{ins_product_1}}
Content-Type: application/json
Authorization: Bearer {{insure_token}}

{
  "name": "水稻种植险"
}

> {%
    client.test("改回自己的名字不冲突", function() {
        client.assert(response.body.code === 200);
    });
%}

