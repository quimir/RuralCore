### ============================================================
### 乡村振兴管理系统 — 农村金融服务模块 测试
### 下载后重命名为 api-test-finance.http
### ============================================================
### 测试账号（DataInitializer 自动创建）:
###   admin / admin123           管理员
###   bank01 / 123456            金融服务商（农村信用社）
###   insure01 / 123456          保险提供商（人保财险）
###   farmer01 / 123456          农户（需先注册）
###   tourist01 / 123456         游客（需先注册）
### ============================================================


### ==================== 0. 初始化登录 ====================

### 0.1 管理员登录
POST http://localhost:8080/api/v1/auth/login
Content-Type: application/json

{ "username": "admin", "password": "admin123" }

> {%
    client.global.set("admin_token", response.body.data.token);
%}

###

### 0.2 注册农户（如果不存在）
POST http://localhost:8080/api/v1/auth/register
Content-Type: application/json

{
  "username": "farmer01",
  "password": "123456",
  "confirmPassword": "123456",
  "nickname": "张老板",
  "role": "FARMER",
  "phone": "13811112222"
}

###

### 0.3 农户登录
POST http://localhost:8080/api/v1/auth/login
Content-Type: application/json

{ "username": "farmer01", "password": "123456" }

> {%
    client.global.set("farmer_token", response.body.data.token);
    client.global.set("farmer_id", response.body.data.userInfo.id);
    client.log("✅ 农户ID: " + response.body.data.userInfo.id);
%}

###

### 0.4 金融服务商登录
POST http://localhost:8080/api/v1/auth/login
Content-Type: application/json

{ "username": "bank01", "password": "123456" }

> {%
    client.global.set("bank_token", response.body.data.token);
%}

###

### 0.5 保险提供商登录
POST http://localhost:8080/api/v1/auth/login
Content-Type: application/json

{ "username": "insure01", "password": "123456" }

> {%
    client.global.set("insure_token", response.body.data.token);
%}

###

### 0.6 注册游客（用于权限测试）
POST http://localhost:8080/api/v1/auth/register
Content-Type: application/json

{
  "username": "tourist01",
  "password": "123456",
  "confirmPassword": "123456",
  "nickname": "游客小王",
  "role": "TOURIST"
}

###

### 0.7 游客登录
POST http://localhost:8080/api/v1/auth/login
Content-Type: application/json

{ "username": "tourist01", "password": "123456" }

> {%
    client.global.set("tourist_token", response.body.data.token);
%}

###


### ==================== 1. 贷款产品（金融服务商） ====================

### 1.1 ✅ 金融服务商发布贷款产品 — 春耕贷
POST http://localhost:8080/api/v1/finance/loan-products
Content-Type: application/json
Authorization: Bearer {{bank_token}}

{
  "name": "春耕贷",
  "type": "CROP_LOAN",
  "description": "面向种植户的春耕备耕专项贷款，利率优惠",
  "minAmount": 10000,
  "maxAmount": 200000,
  "annualRate": 4.35,
  "minTermMonths": 3,
  "maxTermMonths": 12,
  "minCreditScore": 40,
  "requirements": "种植面积10亩以上，有6个月以上平台经营记录",
  "repaymentMethod": "等额本息，到期一次还本"
}

> {%
    client.global.set("loan_product_1", response.body.data.id);
    client.test("贷款产品发布成功", function() {
        client.assert(response.body.code === 200);
        client.assert(response.body.data.providerName === "农村信用社牟平支行");
    });
%}

###

### 1.2 ✅ 发布设备购置贷（高门槛）
POST http://localhost:8080/api/v1/finance/loan-products
Content-Type: application/json
Authorization: Bearer {{bank_token}}

{
  "name": "设备购置贷",
  "type": "EQUIPMENT_LOAN",
  "description": "用于购买农机具、冷链设施等大型设备",
  "minAmount": 50000,
  "maxAmount": 1000000,
  "annualRate": 5.60,
  "minTermMonths": 12,
  "maxTermMonths": 60,
  "minCreditScore": 70,
  "requirements": "年营收10万以上，信用评分≥70",
  "repaymentMethod": "等额本息，按月还款"
}

> {%
    client.global.set("loan_product_2", response.body.data.id);
%}

###

### 1.3 ❌ 游客发布贷款产品（403）
POST http://localhost:8080/api/v1/finance/loan-products
Content-Type: application/json
Authorization: Bearer {{tourist_token}}

{
  "name": "测试",
  "type": "CROP_LOAN",
  "minAmount": 1000,
  "maxAmount": 10000,
  "annualRate": 3.0,
  "minTermMonths": 3,
  "maxTermMonths": 12
}

> {%
    client.test("游客不能发布贷款产品", function() {
        client.assert(response.body.code === 403);
    });
%}

###

