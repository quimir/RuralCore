Content-Type: application/json
Authorization: Bearer {{farmer_token}}

{
  "policyId": {{policy_1}},
  "incidentDate": "2026-06-20",
  "incidentDesc": "6月20日暴雨导致30亩水稻倒伏，预估减产60%",
  "claimAmount": 24000,
  "evidenceImages": "[\"https://example.com/photo1.jpg\", \"https://example.com/photo2.jpg\"]"
}

> {%
    client.global.set("claim_1", response.body.data.id);
