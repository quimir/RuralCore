### ==================== 2. 农户浏览 + 查看信用 + 申请贷款 ====================

### 2.1 农户浏览贷款产品
GET http://localhost:8080/api/v1/finance/loan-products?page=1&size=10
Authorization: Bearer {{farmer_token}}

> {%
    client.test("能看到贷款产品", function() {
        client.assert(response.body.data.records.length >= 2);
    });
%}

###

### 2.2 农户查看自己的财务看板
GET http://localhost:8080/api/v1/finance/dashboard
Authorization: Bearer {{farmer_token}}

> {%
    client.test("看板有数据", function() {
        client.assert(response.body.code === 200);
        client.assert(response.body.data.creditReport !== null, "含信用报告");
        client.assert(response.body.data.suggestions !== null, "含经营建议");
    });
    client.log("✅ 信用评分: " + response.body.data.creditReport.totalScore);
    client.log("✅ 信用等级: " + response.body.data.creditReport.grade);
%}

###

### 2.3 农户查看信用报告
GET http://localhost:8080/api/v1/finance/credit-report
Authorization: Bearer {{farmer_token}}

> {%
    client.global.set("farmer_credit", response.body.data.totalScore);
    client.test("信用报告完整", function() {
        client.assert(response.body.data.historyScore !== undefined);
        client.assert(response.body.data.tradeScore !== undefined);
        client.assert(response.body.data.riskScore !== undefined);
    });
%}

###

### 2.4 ❌ 游客查看财务看板（403）
GET http://localhost:8080/api/v1/finance/dashboard
Authorization: Bearer {{tourist_token}}

> {%
    client.test("游客看不到财务看板", function() {
        client.assert(response.body.code !== 200);
    });
%}

###

### 2.5 ✅ 农户申请春耕贷
POST http://localhost:8080/api/v1/finance/loan-applications
Content-Type: application/json
Authorization: Bearer {{farmer_token}}

{
  "productId": {{loan_product_1}},
  "applyAmount": 50000,
  "applyTermMonths": 6,
  "purpose": "购买春季种子、化肥、农药，计划种植50亩小麦"
}

> {%
    client.global.set("loan_app_1", response.body.data.id);
    client.test("贷款申请成功", function() {
        client.assert(response.body.code === 200);
        client.assert(response.body.data.status === "SUBMITTED");
        client.assert(response.body.data.creditScoreSnapshot !== null, "附上了信用快照");
    });
%}

###

### 2.6 ❌ 重复申请同一产品
POST http://localhost:8080/api/v1/finance/loan-applications
Content-Type: application/json
Authorization: Bearer {{farmer_token}}

{
  "productId": {{loan_product_1}},
  "applyAmount": 30000,
  "applyTermMonths": 3,
  "purpose": "再申请一次"
}

> {%
    client.test("重复申请被拦截", function() {
        client.assert(response.body.code === 400);
        client.assert(response.body.message.indexOf("进行中") >= 0);
    });
%}

###

### 2.7 ❌ 游客申请贷款（403）
POST http://localhost:8080/api/v1/finance/loan-applications
Content-Type: application/json
Authorization: Bearer {{tourist_token}}

{
  "productId": {{loan_product_1}},
  "applyAmount": 10000,
  "applyTermMonths": 3,
  "purpose": "测试"
}

> {%
    client.test("游客不能申请贷款", function() {
        client.assert(response.body.code === 403);
    });
%}

