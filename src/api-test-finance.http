### ==================== 3. 金融服务商审核贷款 ====================

### 3.1 查看待审核列表
GET http://localhost:8080/api/v1/finance/loan-applications/review?status=SUBMITTED&page=1&size=10
Authorization: Bearer {{bank_token}}

> {%
    client.test("有待审核申请", function() {
        client.assert(response.body.data.records.length >= 1);
    });
%}

###

### 3.2 ✅ 批准贷款（可调整金额和利率）
PUT http://localhost:8080/api/v1/finance/loan-applications/{{loan_app_1}}/review
Content-Type: application/json
Authorization: Bearer {{bank_token}}

{
  "approved": true,
  "comment": "经审核，信用良好，批准放款",
  "approvedAmount": 45000,
  "approvedRate": 4.20
}

> {%
    client.test("贷款已批准", function() {
        client.assert(response.body.data.status === "APPROVED");
        client.assert(response.body.data.approvedAmount === 45000);
    });
%}

###

### 3.3 查看审核后的状态
GET http://localhost:8080/api/v1/finance/loan-applications/mine?page=1&size=10
Authorization: Bearer {{farmer_token}}

> {%
    client.test("农户能看到审核结果", function() {
        var app = response.body.data.records[0];
        client.assert(app.status === "APPROVED");
        client.assert(app.approvedRate === 4.20, "利率可能被调整");
    });
%}

