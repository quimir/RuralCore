### ==================== 4. 保险产品（保险提供商） ====================

### 4.1 ✅ 保险商发布水稻种植险
POST http://localhost:8080/api/v1/finance/insurance-products
Content-Type: application/json
Authorization: Bearer {{insure_token}}

{
  "name": "水稻种植险",
  "type": "CROP",
  "description": "保障水稻种植期间因自然灾害导致的减产损失",
  "premium": 18.00,
  "premiumUnit": "亩",
  "coverageAmount": 800.00,
  "coverageMonths": 6,
  "coverageScope": "洪涝、干旱、台风、冰雹、病虫害导致的减产",
  "claimConditions": "减产超过30%可申请理赔，需提供村委会出具的灾害证明"
}

> {%
    client.global.set("ins_product_1", response.body.data.id);
    client.test("保险产品发布成功", function() {
        client.assert(response.body.code === 200);
        client.assert(response.body.data.providerName === "中国人保财险烟台分公司");
    });
%}

