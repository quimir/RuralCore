### ==================== 5. 农户投保 ====================

### 5.1 ✅ 农户投保水稻种植险（50亩）
POST http://localhost:8080/api/v1/finance/policies
Content-Type: application/json
Authorization: Bearer {{farmer_token}}

{
  "productId": {{ins_product_1}},
  "quantity": 50,
  "effectiveDate": "2026-03-15"
}

> {%
    client.global.set("policy_1", response.body.data.id);
    client.global.set("policy_no_1", response.body.data.policyNo);
    client.test("投保成功", function() {
        client.assert(response.body.data.totalPremium === 900.00, "18×50=900");
        client.assert(response.body.data.totalCoverage === 40000.00, "800×50=40000");
        client.assert(response.body.data.status === "PENDING_PAYMENT");
    });
    client.log("✅ 保单号: " + response.body.data.policyNo);
%}

###

### 5.2 支付保费
PUT http://localhost:8080/api/v1/finance/policies/{{policy_1}}/pay
Authorization: Bearer {{farmer_token}}

> {%
    client.test("保费支付成功 → ACTIVE", function() {
        client.assert(response.body.code === 200);
    });
%}

###

