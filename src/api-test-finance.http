Authorization: Bearer {{farmer_token}}

> {%
    client.test("看板含保障数据", function() {
        client.assert(response.body.data.activePolicies >= 0, "有保单统计");
        client.assert(response.body.data.suggestions.length >= 1, "有经营建议");
    });
    client.log("📊 月度趋势: " + response.body.data.monthlyTrend.length + " 个月");
    client.log("💡 经营建议: " + response.body.data.suggestions.length + " 条");
    response.body.data.suggestions.forEach(function(s, i) {
        client.log("  建议" + (i+1) + ": " + s.substring(0, 50) + "...");
    });
%}

