### 6.2 商家编辑被拒绝的民宿（补充信息后重新待审核）
PUT http://localhost:8080/api/v1/tourism/spots/{{spot_farmstay}}
Content-Type: application/json
Authorization: Bearer {{farmer_token}}

{
  "title": "云上山居·精品民宿（已补充证照）",
  "summary": "隐于山林间的田园民宿，推窗见山，枕星入梦。已取得营业执照和消防安全证明。",
  "content": "## 证照信息\n- 营业执照编号: 330xxxxx\n- 消防安全证明: 已通过\n\n## 民宿特色\n...",
  "type": "FARMSTAY",
  "address": "浙江省杭州市临安区太湖源镇白沙村",
  "ticketPrice": 298,
  "openingHours": "全年营业"
}

> {%
    client.test("编辑后重新待审核", function() {
        client.assert(response.body.data.status === "PENDING");
    });
%}

###

### 6.3 ❌ 游客不能编辑别人的项目（期望 403）
PUT http://localhost:8080/api/v1/tourism/spots/{{spot_picking}}
Content-Type: application/json
Authorization: Bearer {{tourist_token}}

{
  "title": "被篡改",
  "summary": "test",
  "type": "SCENIC_SPOT"
}

> {%
    client.test("游客不能编辑", function() {
        client.assert(response.body.code === 403);
    });
%}

