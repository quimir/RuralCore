### 6.7 余量恢复验证
GET http://localhost:8080/api/v1/tourism/spots/{{spot_id}}/tickets?date=2026-04-01

> {%
    client.test("取消后余量恢复", function() {
        var vip = response.body.data.find(t => t.name === "VIP体验票");
