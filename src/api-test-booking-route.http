### ==================== 4. 预约状态流转 ====================

### 4.1 查看我的预约列表
GET http://localhost:8080/api/v1/tourism/bookings?page=1&size=10
Authorization: Bearer {{tourist_token}}

> {%
    client.test("有预约记录", function() {
        client.assert(response.body.data.records.length >= 2);
    });
%}

###

### 4.2 查看预约详情
GET http://localhost:8080/api/v1/tourism/bookings/{{booking_1}}
Authorization: Bearer {{tourist_token}}

> {%
    client.test("详情完整", function() {
        client.assert(response.body.data.bookingCode === client.global.get("booking_code_1"));
        client.assert(response.body.data.spotName !== null);
    });
%}

###

### 4.3 支付预约
PUT http://localhost:8080/api/v1/tourism/bookings/{{booking_1}}/pay
Authorization: Bearer {{tourist_token}}

> {%
    client.test("支付成功 → CONFIRMED", function() {
        client.assert(response.body.code === 200);
    });
%}

###

### 4.4 查看支付后的状态
GET http://localhost:8080/api/v1/tourism/bookings/{{booking_1}}
Authorization: Bearer {{tourist_token}}

> {%
    client.test("状态已变CONFIRMED", function() {
        client.assert(response.body.data.status === "CONFIRMED");
        client.assert(response.body.data.paidAt !== null);
    });
%}

###

### 4.5 ❌ 重复支付
PUT http://localhost:8080/api/v1/tourism/bookings/{{booking_1}}/pay
Authorization: Bearer {{tourist_token}}

> {%
    client.test("不能重复支付", function() {
        client.assert(response.body.code === 400);
    });
%}

###

### 4.6 商家核验预约码
PUT http://localhost:8080/api/v1/tourism/bookings/verify
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "bookingCode": "{{booking_code_1}}"
}

> {%
    client.test("核验成功 → USED", function() {
        client.assert(response.body.data.status === "USED");
        client.assert(response.body.data.usedAt !== null);
    });
%}

###

### 4.7 ❌ 再次核验
PUT http://localhost:8080/api/v1/tourism/bookings/verify
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "bookingCode": "{{booking_code_1}}"
}

> {%
    client.test("已使用不能再核验", function() {
        client.assert(response.body.code === 400);
    });
%}

###

### 4.8 取消住宿预约（待付款状态可取消）
PUT http://localhost:8080/api/v1/tourism/bookings/{{booking_room}}/cancel
Authorization: Bearer {{tourist_token}}

> {%
    client.test("取消成功", function() {
        client.assert(response.body.code === 200);
    });
%}

###

### 4.9 取消后余量应恢复 — 查民宿票型余量
GET http://localhost:8080/api/v1/tourism/spots/{{spot_room}}/tickets?date=2026-03-15

> {%
    client.test("取消后余量恢复", function() {
        var room = response.body.data[0];
        client.assert(room.remaining === room.dailyCapacity, "容量已恢复");
    });
%}

###

### ==================== 5. 路线规划 ====================

### 5.1 游客创建路线
POST http://localhost:8080/api/v1/tourism/routes
Content-Type: application/json
Authorization: Bearer {{tourist_token}}

{
  "title": "烟台周末两日游",
  "description": "采摘+民宿，带娃度周末",
  "totalDays": 2,
  "startDate": "2026-03-20",
  "isPublic": false,
  "items": [
    {
      "spotId": {{spot_id}},
      "dayNumber": 1,
      "sortOrder": 1,
      "visitTime": "09:00",
      "durationMinutes": 180,
      "notes": "上午摘草莓，中午园区吃饭"
    },
    {
      "spotId": {{spot_room}},
      "dayNumber": 1,
      "sortOrder": 2,
      "visitTime": "15:00",
      "notes": "下午入住民宿，晚上看星空"
    },
    {
      "spotId": {{spot_id}},
      "dayNumber": 2,
      "sortOrder": 1,
      "visitTime": "09:00",
      "durationMinutes": 120,
      "notes": "第二天上午再摘一波，带回家"
    }
  ]
}

> {%
    client.global.set("route_id", response.body.data.id);
    client.test("路线创建成功", function() {
        client.assert(response.body.data.totalDays === 2);
        client.assert(response.body.data.days.length === 2, "有2天的行程");
        client.assert(response.body.data.days[0].spots.length === 2, "第一天2个景点");
        client.assert(response.body.data.days[1].spots.length === 1, "第二天1个景点");
        client.assert(response.body.data.isPublic === false, "默认私有");
    });
    client.log("✅ 路线ID: " + response.body.data.id);
%}

###

### 5.2 查看路线详情
GET http://localhost:8080/api/v1/tourism/routes/{{route_id}}
Authorization: Bearer {{tourist_token}}

> {%
    client.test("详情含景点信息", function() {
        var day1 = response.body.data.days[0];
        client.assert(day1.spots[0].spotName !== null);
        client.assert(day1.date === "2026-03-20", "日期自动计算");
    });
%}

###

### 5.3 ❌ 私有路线其他人不能看
GET http://localhost:8080/api/v1/tourism/routes/{{route_id}}
Authorization: Bearer {{farmer_token}}

> {%
    client.test("私有路线403", function() {
        client.assert(response.body.code === 403);
    });
%}

###

### 5.4 编辑路线 — 设为公开 + 修改行程
PUT http://localhost:8080/api/v1/tourism/routes/{{route_id}}
Content-Type: application/json
Authorization: Bearer {{tourist_token}}

{
  "title": "烟台周末两日游（推荐）",
  "description": "采摘+民宿，亲测好评！",
  "totalDays": 2,
  "startDate": "2026-03-20",
  "isPublic": true,
  "items": [
    {
      "spotId": {{spot_id}},
      "dayNumber": 1,
      "sortOrder": 1,
      "visitTime": "09:00",
      "durationMinutes": 180,
      "notes": "上午摘草莓"
    },
    {
      "spotId": {{spot_room}},
      "dayNumber": 2,
      "sortOrder": 1,
      "notes": "住一晚看星空"
    }
  ]
}

> {%
    client.test("编辑成功且已公开", function() {
        client.assert(response.body.data.isPublic === true);
        client.assert(response.body.data.title.indexOf("推荐") >= 0);
    });
%}

###

### 5.5 查看公开推荐路线列表（不需要登录）
GET http://localhost:8080/api/v1/tourism/routes/public?page=1&size=10

> {%
    client.test("公开路线可见", function() {
        client.assert(response.body.data.records.length >= 1);
    });
%}

