### ============================================================
### 乡村振兴管理系统 — 旅游预约 + 路线规划 测试
### 下载后重命名为 api-test-booking-route.http
### ============================================================
### 前置条件: 先跑 api-test-tourism.http 的初始化部分
###   - 管理员 admin/admin123 已登录 → admin_token
###   - 商家 farmer01 已登录 → farmer_token
###   - 游客 tourist01 已登录 → tourist_token
###   - 已有 APPROVED 的采摘园(spot_picking) 和 非遗体验(spot_folk)
### ============================================================


### ==================== 0. 初始化 ====================

### 0.1 管理员登录
POST http://localhost:8080/api/v1/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "admin123"
}

> {%
    client.global.set("admin_token", response.body.data.token);
%}

###

### 0.2 商家登录
POST http://localhost:8080/api/v1/auth/login
Content-Type: application/json

{
  "username": "farmer01",
  "password": "123456"
}

> {%
    client.global.set("farmer_token", response.body.data.token);
%}

###

### 0.3 游客登录
POST http://localhost:8080/api/v1/auth/login
Content-Type: application/json

{
  "username": "tourist01",
  "password": "123456"
}

> {%
    client.global.set("tourist_token", response.body.data.token);
%}

###

### 0.4 管理员发布采摘园（如果还没有）
POST http://localhost:8080/api/v1/tourism/spots
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "title": "测试采摘园-预约用",
  "summary": "专门用于测试预约功能的采摘园",
  "type": "PICKING_GARDEN",
  "address": "山东省烟台市测试路1号",
  "openingHours": "08:00-17:30",
  "ticketPrice": 0
}

> {%
    client.global.set("spot_id", response.body.data.id);
    client.log("✅ 测试景点ID: " + response.body.data.id);
%}

###

### 0.5 管理员发布民宿
POST http://localhost:8080/api/v1/tourism/spots
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "title": "测试民宿-预约用",
  "summary": "专门用于测试住宿预约的民宿",
  "type": "FARMSTAY",
  "address": "浙江省杭州市测试路2号",
  "openingHours": "全年营业",
  "ticketPrice": 298
}

> {%
    client.global.set("spot_room", response.body.data.id);
    client.log("✅ 测试民宿ID: " + response.body.data.id);
%}

###

### ==================== 1. 票务配置（商家/管理员） ====================

### 1.1 管理员为采摘园添加票型 — 成人票
POST http://localhost:8080/api/v1/tourism/spots/{{spot_id}}/tickets
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "name": "成人票",
  "description": "含入园+采摘体验，可带走2斤水果",
  "price": 68.00,
  "category": "TICKET",
  "dailyCapacity": 100,
  "minQuantity": 1,
  "maxQuantity": 10,
  "advanceDays": 0
}

> {%
    client.global.set("ticket_adult", response.body.data.id);
    client.test("成人票创建成功", function() {
        client.assert(response.body.code === 200);
        client.assert(response.body.data.category === "TICKET");
    });
    client.log("✅ 成人票ID: " + response.body.data.id);
%}

###

### 1.2 添加儿童票
POST http://localhost:8080/api/v1/tourism/spots/{{spot_id}}/tickets
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "name": "儿童票",
  "description": "1.2m以下儿童，需家长陪同",
  "price": 38.00,
  "category": "TICKET",
  "dailyCapacity": 50,
  "minQuantity": 1,
  "maxQuantity": 5,
  "advanceDays": 0
}

> {%
    client.global.set("ticket_child", response.body.data.id);
%}

###

### 1.3 添加家庭套票（至少2人起订）
POST http://localhost:8080/api/v1/tourism/spots/{{spot_id}}/tickets
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "name": "家庭套票",
  "description": "2大1小，含午餐",
  "price": 158.00,
  "category": "TICKET",
  "dailyCapacity": 30,
  "minQuantity": 1,
  "maxQuantity": 5,
  "advanceDays": 1
}

> {%
    client.global.set("ticket_family", response.body.data.id);
%}

###

### 1.4 为民宿添加票型 — 标准间（住宿类）
POST http://localhost:8080/api/v1/tourism/spots/{{spot_room}}/tickets
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "name": "标准间",
  "description": "大床房，含早餐",
  "price": 298.00,
  "category": "ROOM",
  "dailyCapacity": 10,
  "minQuantity": 1,
  "maxQuantity": 3,
  "advanceDays": 1
}

> {%
    client.global.set("ticket_room", response.body.data.id);
    client.test("住宿票型创建成功", function() {
        client.assert(response.body.data.category === "ROOM");
    });
%}

###

### 1.5 ❌ 重复票型名称
POST http://localhost:8080/api/v1/tourism/spots/{{spot_id}}/tickets
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "name": "成人票",
  "price": 88.00,
  "category": "TICKET",
  "dailyCapacity": 50
}

> {%
    client.test("同名票型被拦截", function() {
        client.assert(response.body.code === 400);
    });
%}

###

### ==================== 2. 查看票型（公开） ====================

### 2.1 不带日期 — 不返回余量
GET http://localhost:8080/api/v1/tourism/spots/{{spot_id}}/tickets

> {%
    client.test("返回票型列表", function() {
        client.assert(response.body.data.length >= 3);
        client.assert(response.body.data[0].remaining === null, "无日期时不返回余量");
    });
%}

###

### 2.2 带日期 — 返回余量
GET http://localhost:8080/api/v1/tourism/spots/{{spot_id}}/tickets?date=2026-03-15

> {%
    client.test("带日期返回余量", function() {
        var first = response.body.data[0];
        client.assert(first.remaining !== null, "有余量");
        client.assert(first.remaining === first.dailyCapacity, "未预约时余量=容量");
    });
%}

###

### ==================== 3. 在线预约（用户） ====================

### 3.1 游客预约成人票（2张）
POST http://localhost:8080/api/v1/tourism/bookings
Content-Type: application/json
Authorization: Bearer {{tourist_token}}

{
  "ticketId": {{ticket_adult}},
  "visitDate": "2026-03-15",
  "quantity": 2,
  "contactName": "旅行者小王",
  "contactPhone": "13900139000",
  "remark": "带2个朋友"
}

> {%
    client.global.set("booking_1", response.body.data.id);
    client.global.set("booking_code_1", response.body.data.bookingCode);
    client.test("预约成功", function() {
        client.assert(response.body.code === 200);
        client.assert(response.body.data.status === "PENDING_PAYMENT");
        client.assert(response.body.data.totalAmount === 136.00, "68×2=136");
        client.assert(response.body.data.bookingCode.length === 6, "6位预约码");
    });
    client.log("✅ 预约码: " + response.body.data.bookingCode);
%}

###

### 3.2 查看余量变化（应减少2）
GET http://localhost:8080/api/v1/tourism/spots/{{spot_id}}/tickets?date=2026-03-15

> {%
    client.test("余量已减少", function() {
        var adult = response.body.data.find(t => t.name === "成人票");
        client.assert(adult.remaining === adult.dailyCapacity - 2, "余量减2");
    });
%}

###

### 3.3 预约住宿（标准间，住2晚）
POST http://localhost:8080/api/v1/tourism/bookings
Content-Type: application/json
Authorization: Bearer {{tourist_token}}

{
  "ticketId": {{ticket_room}},
  "checkIn": "2026-03-15",
  "checkOut": "2026-03-17",
  "quantity": 1,
  "contactName": "旅行者小王",
  "contactPhone": "13900139000"
}

> {%
    client.global.set("booking_room", response.body.data.id);
    client.test("住宿预约成功", function() {
        client.assert(response.body.data.nights === 2, "住2晚");
        client.assert(response.body.data.totalAmount === 596.00, "298×1×2晚=596");
    });
%}

###

### 3.4 ❌ 住宿类不传日期
POST http://localhost:8080/api/v1/tourism/bookings
Content-Type: application/json
Authorization: Bearer {{tourist_token}}

{
  "ticketId": {{ticket_room}},
  "visitDate": "2026-03-20",
  "quantity": 1,
  "contactName": "测试",
  "contactPhone": "13800138000"
}

> {%
    client.test("住宿类必须传入住退房日期", function() {
        client.assert(response.body.code === 400);
    });
%}

###

### 3.5 ❌ 预约过去的日期
POST http://localhost:8080/api/v1/tourism/bookings
Content-Type: application/json
Authorization: Bearer {{tourist_token}}

{
  "ticketId": {{ticket_adult}},
  "visitDate": "2020-01-01",
  "quantity": 1,
  "contactName": "测试",
  "contactPhone": "13800138000"
}

> {%
    client.test("不能预约过去日期", function() {
        client.assert(response.body.code === 400);
    });
%}

###

### 3.6 ❌ 低于最小数量
POST http://localhost:8080/api/v1/tourism/bookings
Content-Type: application/json
Authorization: Bearer {{tourist_token}}

{
  "ticketId": {{ticket_adult}},
  "visitDate": "2026-03-16",
  "quantity": 0,
  "contactName": "测试",
  "contactPhone": "13800138000"
}

> {%
    client.test("数量校验", function() {
        client.assert(response.body.code !== 200);
    });
%}

